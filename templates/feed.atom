<?xml version="1.0" encoding="utf-8"?>
{#-
  Jinja autoescaping is OFF for this template: Flask only enables it for
  .html/.htm/.xml/.xhtml/.svg names, and this file is feed.atom. Every
  interpolation below therefore uses `| e` explicitly. Miss one and a title
  containing "&" or "<" produces malformed XML that readers refuse to parse.
-#}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site_name | e }}</title>
  <subtitle>{{ site_description | e }}</subtitle>
  <link href="{{ feed_url | e }}" rel="self" type="application/atom+xml"/>
  <link href="{{ base_url | e }}/" rel="alternate" type="text/html"/>
  <id>{{ base_url | e }}/</id>
  <updated>{{ updated | e }}</updated>
  <author>
    <name>{{ site_author | e }}</name>
  </author>
  {% for post in posts %}
  <entry>
    <title>{{ post.title | e }}</title>
    <link href="{{ base_url | e }}/post/{{ post.slug | e }}/" rel="alternate" type="text/html"/>
    <id>{{ base_url | e }}/post/{{ post.slug | e }}/</id>
    <published>{{ iso_moment(post.date) | e }}</published>
    <updated>{{ iso_moment(post.date) | e }}</updated>
    <summary>{{ post.summary | e }}</summary>
    <content type="html">{{ post.body_html | e }}</content>
  </entry>
  {% endfor %}
</feed>
